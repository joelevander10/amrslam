agv-kim2a-controller/
**/__pycache__/
*.py[cod]
*.log
*.sh

# Deployment and environment scripts are part of the product (unified plan U0).
!amr_ws/deploy/*.sh
!amr_ws/env/*.sh
# The run recorder (run_log.sh) and its kin are tooling, not artifacts: bag_report.py
# depends on what run_log.sh records (manuals/obsolete/0910-fix-plan-001.md A3).
!tools/*.sh

# Run logs are evidence, not source: keep them out of the tree.
logs/

# Tool caches. Ruff and pytest drop these wherever they are invoked from, which
# in a colcon workspace means one per package; none of them are source.
.ruff_cache/
.pytest_cache/
*.egg-info/
build/
install/
log/

# Agent instruction files are per-developer, not source.
AGENTS.md
CLAUDE.md

# macOS Finder metadata
.DS_Store
# Vehicle logs copied in on purpose (2026-11-03): kept as evidence, so exempt from the
# *.log / log/ rules above. Only this folder; other run logs stay out of the tree.
!field-logs/**
