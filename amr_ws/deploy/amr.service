[Unit]
Description=Unified AMR supervisor, hardware, web UI, mapping and navigation
Documentation=file:///home/amrslam/agv_can/amr_ws/RUNBOOK.md
# No BindsTo/After on can0 (2026-10-27): the CAN owner waits for can0 and reports "no bus".
# On the AMR QR can0 is the USB CAN adapter brought up by qr/slcan-can0.service; ordering
# after it (not requiring it) lets the web UI come up even when the adapter is missing.
After=network-online.target slcan-can0.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# Type=notify + WatchdogSec: the supervisor pings every loop tick (amr_bringup/
# sdnotify.py). A WEDGED loop - alive process, dead loop - is restarted like a
# crash; Restart=on-failure alone never caught that case.
Type=notify
NotifyAccess=main
WatchdogSec=30
# Boot can legitimately take a while: the base budget is 30 s and the drives sat at
# "Switch on disabled" for 70 s waiting for the cabinet reset (2026-09-22). READY=1 is
# sent whatever the outcome, but the margin costs nothing.
TimeoutStartSec=180
User=amrslam
Group=amrslam
WorkingDirectory=/home/amrslam/agv_can/amr_ws
Environment=HOME=/home/amrslam
EnvironmentFile=/home/amrslam/agv_can/amr_ws/deploy/amr.env

# Device owners take advisory locks here before opening CAN or Modbus, so a
# bench tool started by hand refuses while the service owns the bus.
ExecStartPre=+/usr/bin/install -d -o root -g root -m 1777 /run/lock/amr
ExecStartPre=+/usr/bin/install -d -o amrslam -g amrslam -m 0755 ${AMR_STATE_DIR}
ExecStartPre=+/usr/bin/install -d -o amrslam -g amrslam -m 0755 ${AMR_MAPS_DIR}
ExecStart=/home/amrslam/agv_can/amr_ws/deploy/amr-supervisor.sh

# SIGINT lets the supervisor revoke its lease, stop the active mode layer,
# disarm the drives through base.launch.py, then stop web/bridge. If that
# bounded path hangs, systemd kills the whole cgroup after TimeoutStopSec.
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=55
# The teardown sends STOPPING=1, so a slow, bounded stop is not a watchdog kill.
SendSIGKILL=yes

Restart=on-failure
RestartSec=5
UMask=0022

[Install]
WantedBy=multi-user.target
