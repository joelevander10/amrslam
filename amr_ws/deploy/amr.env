# Environment for amr.service. Boot always enters IDLE; no map, survey,
# commissioning job or route is selected or replayed here.
# Which vehicle (profiles/<name>.json): amr-qr-01 = the AMR QR (analog drives, CANopen
# encoders, WitMotion IMU); agv-01 = gvievo-01 (BLV-R CAN drives, MLS, RFID).
AGV_PROFILE=amr-qr-01
AMR_MAPS_DIR=/home/amrslam/amr_maps
AMR_STATE_DIR=/home/amrslam/.amr
AMR_WEB=true
AMR_LIDAR=true
# AMCL against the map with dynamic areas (trolleys) blanked, on a second map_server
# (navigation_layer blank_dynamic). Only the areas marked "dynamic" (Edit areas) are blanked;
# a map with none is used as it is. On for the AMR QR (owner, 2026-11-09). The navigation
# layer refuses to start if fewer than 500 occupied cells remain outside the dynamic areas.
AMR_LOC_BLANK_DYNAMIC=true
# Smoothed map->odom (amr_localization/pose_smoother.py, owner 2026-11-12): AMCL's corrections
# are worked in over a second or two of driving instead of in one 5 cm step, so the
# controller does not chase AMCL's jitter (the wobble in the dynamic areas, where few beams
# hold the pose). AMCL itself (losses, scan check) is judged unsmoothed. false = AMCL's TF.
AMR_LOC_SMOOTH_POSE=true
