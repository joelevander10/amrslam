<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_sim</name>
  <version>0.0.1</version>
  <description>Sim / mock layer (spec §8): fake base, scan synthesiser, fake IMU. Swaps Layer-1 nodes only; every interface above is identical.</description>
  <maintainer email="igp.indi.4.0.00@gmail.com">gvipc</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>amr_base</exec_depend>
  <exec_depend>amr_maps</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
