<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_base</name>
  <version>0.0.1</version>
  <description>Layer-1 base nodes: command mux + inverse kinematics, wheel odometry, and (T9) the CANopen drive node.</description>
  <maintainer email="igp.indi.4.0.00@gmail.com">gvipc</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-can</exec_depend>
  <exec_depend>python3-serial</exec_depend>  <!-- AMR QR WitMotion IMU (qr_base_node) -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
