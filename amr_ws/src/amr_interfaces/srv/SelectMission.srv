# Choose the tape job for the next LINE run (line_follow_node, /amr/line/mission).
# Accepted only while the layer is IDLE or DONE. "" or "none" = plain line following;
# otherwise agv_core.mission.load(name) must accept missions/<name>.json.
string name
# Appended 2026-10-08. A label from the mission's destination stops (e.g. "MRU2"),
# or "" for none. A mission with destination stops refuses Start without one.
string destination
---
bool ok
string message
