# Survey transactions through the supervisor (unified plan §5.4, §5.5).
uint8 START=0
uint8 RETURNED=1
uint8 SAVE=2
uint8 ABORT=3
string request_id
string expected_instance
uint32 expected_generation
uint8 operation
string map_id               # START
string description          # START: physical start-mark description; SAVE: review note
uint32 continue_revision     # START: 0 = a new map; N = continue <map_id> revN (StartSurvey)
geometry_msgs/Pose2D hint    # START with continue_revision: the vehicle's pose in revN's frame
---
bool accepted
string operation_id
string message
