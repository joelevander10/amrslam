<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_line</name>
  <version>0.0.1</version>
  <description>LINE layer (dual-product plan, Increment 1): magnetic-tape line following. The control engine is a byte-for-byte port of the gy-demo controller's autopilot and branch modules; everything else here is the ROS shell around it.</description>
  <maintainer email="igp.indi.4.0.00@gmail.com">gvipc</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>amr_mission</exec_depend>  <!-- map bundle hashes for the tape graph binding -->
  <!-- The vehicle library at the repo root (kinematics, and the profile the
       engine's runtime namespace is loaded from). Not a rosdep key: install it
       with `pip install -e .` from the repo root, or put the repo root on
       PYTHONPATH (amr_ws/deploy/amr-launch.sh does the latter). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
