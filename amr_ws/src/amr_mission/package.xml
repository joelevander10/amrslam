  <version>0.0.1</version>
  <description>Coordinators: survey/mapping session (T4), route executor and permission/run state (T7, T8).</description>
  <maintainer email="igp.indi.4.0.00@gmail.com">gvipc</maintainer>
  <license>Proprietary</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>amr_interfaces</exec_depend>
  <exec_depend>amr_maps</exec_depend>
  <exec_depend>amr_navigation</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
